        <mxCell id="x4" value="Transactional email&#10;&#10;password reset link (US-70)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#7f7f7f;" vertex="1" parent="1">
          <mxGeometry x="1235" y="1490" width="280" height="140" as="geometry" />
