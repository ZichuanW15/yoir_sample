        <mxCell id="dm11" value="ForumBoard / Post / Reply / Like" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffffff;strokeColor=#7f7f7f;" vertex="1" parent="1"><mxGeometry x="1255" y="1050" width="220" height="26" as="geometry" /></mxCell>
        <mxCell id="dm12" value="Dispute" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffffff;strokeColor=#7f7f7f;" vertex="1" parent="1"><mxGeometry x="1255" y="1082" width="220" height="26" as="geometry" /></mxCell>

        <mxCell id="fsm" value="&lt;b&gt;Order state machine — mitigates R-05&lt;/b&gt;&#10;&#10;PENDING → AWAITING_PAYMENT → CONFIRMED → COMPLETED&#10;&#10;↳ EXPIRED — slot hold lapses after 15 min&#10;↳ CANCELLED / DISPUTED&#10;&#10;A booking is confirmed &lt;u&gt;only&lt;/u&gt; by the Stripe webhook,&#10;never by the client success callback." style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e8f5e9;strokeColor=#2e7d32;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1510" y="600" width="250" height="185" as="geometry" />
        </mxCell>
        <mxCell id="idem" value="&lt;b&gt;Idempotent webhooks&lt;/b&gt;&#10;&#10;UNIQUE(stripe_event_id) — a replayed&#10;or retried event is a no-op." style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e8f5e9;strokeColor=#2e7d32;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1510" y="810" width="250" height="100" as="geometry" />
        </mxCell>

        <!-- ============ DATABASE ============ -->
        <mxCell id="pg" value="PostgreSQL 16" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fontStyle=1;fillColor=#336791;strokeColor=none;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="1910" y="380" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="dbn1" value="&lt;b&gt;Double-booking guard&lt;/b&gt;&#10;US-41 · NFR-06&#10;&#10;UNIQUE (counsellor_id, slot_start)&#10;+ SELECT … FOR UPDATE inside one&#10;transaction. Postgres is the&#10;concurrency primitive — no Redis lock." style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff8e1;strokeColor=#c8a415;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1890" y="530" width="240" height="145" as="geometry" />
        </mxCell>
        <mxCell id="dbn2" value="&lt;b&gt;No Redis in the MVP&lt;/b&gt;&#10;&#10;One source of truth. Cache and task&#10;queue are deferred; revisit only if&#10;load testing shows the need." style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff8e1;strokeColor=#c8a415;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1890" y="700" width="240" height="115" as="geometry" />
        </mxCell>
        <mxCell id="dbn3" value="&lt;b&gt;NFR-04&lt;/b&gt;&#10;&#10;No raw card data is stored anywhere&#10;in Yoir. Only Stripe references&#10;(payment_intent_id, event_id)." style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ede7f6;strokeColor=#635BFF;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1890" y="840" width="240" height="115" as="geometry" />
        </mxCell>

        <!-- ============ EXTERNAL SERVICES ============ -->
        <mxCell id="x1" value="Object storage&#10;(Supabase Storage / Cloudinary)&#10;&#10;profile + service images" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#7f7f7f;" vertex="1" parent="1">
          <mxGeometry x="335" y="1490" width="280" height="140" as="geometry" />
        </mxCell>
        <mxCell id="x2" value="LinkedIn profile URL&#10;&#10;manual Platform Owner review&#10;— no API dependency (R-01)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#7f7f7f;" vertex="1" parent="1">
          <mxGeometry x="635" y="1490" width="280" height="140" as="geometry" />
        </mxCell>
        <mxCell id="x3" value="Stripe — TEST MODE&#10;&#10;PaymentSheet SDK on device&#10;+ webhooks to the backend" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#635BFF;strokeColor=none;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="935" y="1490" width="280" height="140" as="geometry" />
