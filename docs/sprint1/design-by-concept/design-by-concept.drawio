        </mxCell>
        <mxCell id="fsm" value="&lt;b&gt;Order and booking states — mitigate R-05&lt;/b&gt;&#10;&#10;Order: awaiting_payment → confirmed&#10;↳ cancelled: 15-min hold lapsed&#10;↳ refunded_slot_taken: paid too late&#10;&#10;Booking: confirmed → completed → paid_out&#10;↳ cancelled / refunded by a participant&#10;&#10;Only the Stripe webhook confirms an order,&#10;never the client's success callback." style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e8f5e9;strokeColor=#2e7d32;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1510" y="600" width="250" height="200" as="geometry" />
        </mxCell>
        <mxCell id="idem" value="&lt;b&gt;Idempotent webhooks&lt;/b&gt;&#10;&#10;processed_webhook_events.event_id is the&#10;primary key, so a replayed or retried&#10;event is a no-op." style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e8f5e9;strokeColor=#2e7d32;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1510" y="820" width="250" height="100" as="geometry" />
        </mxCell>
        <!-- ============ DATABASE ============ -->
        <mxCell id="pg" value="PostgreSQL 16&#10;&lt;font style=&quot;font-size:11px&quot;&gt;Neon in the cloud&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fontStyle=1;fillColor=#336791;strokeColor=none;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="1910" y="380" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="dbn1" value="&lt;b&gt;Double-booking guard&lt;/b&gt;&#10;US-41 · NFR-06&#10;&#10;The booking transaction locks the&#10;Career Professional's row&#10;(SELECT … FOR UPDATE), then checks&#10;the time is still free. Proven by a&#10;concurrent PostgreSQL test.&#10;&#10;&lt;i&gt;Gap:&lt;/i&gt; no database EXCLUDE constraint&#10;yet; kept visible as a strict&#10;expected-failure test." style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff8e1;strokeColor=#c8a415;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1890" y="530" width="240" height="215" as="geometry" />
        </mxCell>
        <mxCell id="dbn2" value="&lt;b&gt;No Redis in the MVP&lt;/b&gt;&#10;&#10;One source of truth. Cache and task&#10;queue are deferred; revisit only if&#10;load testing shows the need." style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff8e1;strokeColor=#c8a415;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1890" y="770" width="240" height="115" as="geometry" />
        </mxCell>
        <mxCell id="dbn3" value="&lt;b&gt;NFR-04&lt;/b&gt;&#10;&#10;No raw card data is stored anywhere&#10;in Yoir. Only Stripe references&#10;(payment_intent_id, transfer_id,&#10;webhook event_id)." style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ede7f6;strokeColor=#635BFF;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1890" y="905" width="240" height="115" as="geometry" />
        </mxCell>
