# Keep binary formats out of text diffs so `git diff --check` never scans their streams.
*.pdf  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary

# Preserve verbatim QA tool output, including its trailing whitespace.
docs/sprint2/qa/evidence/**/*.log -whitespace
docs/sprint2/qa/evidence/**/error-context.md -whitespace
