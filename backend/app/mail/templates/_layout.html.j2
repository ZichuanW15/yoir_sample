{#
  The shell every Yoir email extends.

  Colours are the app's own tokens from frontend/src/theme.ts, so mail looks like the
  product rather than like a different company. Styles are inline and the layout is a
  table: Gmail strips <style> blocks and Outlook ignores flexbox, so the only things
  that render reliably everywhere are inline attributes on nested tables.
#}
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{% block subject %}{{ brand }}{% endblock %}</title>
  </head>
  <body style="margin:0; padding:0; background:#EFEDE6; color:#12241A;
               font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
    {# Shown in the inbox list next to the subject, before anything is opened. #}
    <div style="display:none; max-height:0; overflow:hidden; opacity:0;">
      {% block preview %}{% endblock %}
    </div>

    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
           style="background:#EFEDE6; padding:24px 12px;">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
                 style="max-width:560px; background:#FFFFFF; border-radius:24px; overflow:hidden;">

            <tr>
              <td style="background:#1E3A27; padding:22px 28px;">
                <span style="font-size:20px; font-weight:700; letter-spacing:.2px; color:#FFFFFF;">
                  {{ brand }}
                </span>
              </td>
            </tr>

            <tr>
              <td style="padding:30px 28px 8px 28px;">
                <h1 style="margin:0 0 6px 0; font-size:25px; line-height:1.25; font-weight:600; color:#12241A;">
                  {% block heading %}{% endblock %}
                </h1>
                {% block subheading %}{% endblock %}
              </td>
            </tr>

            <tr>
              <td style="padding:8px 28px 28px 28px; font-size:15px; line-height:1.6; color:#12241A;">
                {% block content %}{% endblock %}
              </td>
            </tr>

            <tr>
              <td style="padding:18px 28px 26px 28px; border-top:1px solid #EEEBE3;
                         font-size:12px; line-height:1.6; color:#66756B;">
                {% block footer %}
                  You are receiving this because you have a {{ brand }} account.
                {% endblock %}
              </td>
            </tr>

          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
