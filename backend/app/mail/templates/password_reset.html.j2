{% extends "_layout.html.j2" %}
{% import "_ui.html.j2" as ui %}

{% block subject %}Reset your password · {{ brand }}{% endblock %}
{% block preview %}A link to choose a new password, valid for {{ expires_in_hours }} hours.{% endblock %}
{% block heading %}Reset your password{% endblock %}

{% block content %}
<p style="margin:0 0 14px 0;">Hi {{ name }},</p>

<p style="margin:0 0 14px 0;">
  Someone asked to reset the password for this {{ brand }} account. If that was you,
  choose a new one here.
</p>

{{ ui.button(reset_url, "Choose a new password") }}

{{ ui.notice("Resetting your password signs you out everywhere else, on every device. That is deliberate: if someone else asked for this, it ends their access too.") }}

<p style="margin:0 0 14px 0; font-size:13px; color:#66756B;">
  The link works once and expires in {{ expires_in_hours }} hours.
</p>

<p style="margin:0; font-size:13px; color:#66756B;">
  If the button does not work, paste this into your browser:<br />
  <span style="word-break:break-all; color:#2E6B4F;">{{ reset_url }}</span>
</p>
{% endblock %}

{% block footer %}
  If you did not ask for this, you can ignore this email — your password has not
  changed, and nobody can change it without the link above.
{% endblock %}
