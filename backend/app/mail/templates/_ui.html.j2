{#
  Reusable pieces, kept apart from `_layout.html.j2` on purpose.

  Importing a template runs its body, so macros living inside the layout would render
  the whole page shell — without the caller's context — just to get at a button. A
  macros-only file has no body to run.

  Inline styles and nested tables throughout: Gmail strips <style> blocks and Outlook
  ignores flexbox, so attributes on tables are the only thing that renders everywhere.
#}

{% macro button(href, label) -%}
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:22px 0;">
  <tr>
    <td style="background:#1E3A27; border-radius:16px;">
      <a href="{{ href }}"
         style="display:inline-block; padding:14px 26px; font-size:15px; font-weight:600;
                color:#FFFFFF; text-decoration:none;">{{ label }}</a>
    </td>
  </tr>
</table>
{%- endmacro %}

{% macro detail_rows(rows) -%}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
       style="margin:18px 0; background:#FAF9F5; border-radius:20px;">
  {% for label, value in rows %}
  <tr>
    <td style="padding:12px 18px; font-size:14px; color:#66756B;">{{ label }}</td>
    <td align="right" style="padding:12px 18px; font-size:14px; font-weight:600; color:#12241A;">
      {{ value }}
    </td>
  </tr>
  {% endfor %}
</table>
{%- endmacro %}

{% macro notice(text) -%}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
       style="margin:18px 0; background:#FBF0D6; border-radius:20px;">
  <tr>
    <td style="padding:14px 18px; font-size:13px; line-height:1.6; color:#5A3D12;">{{ text }}</td>
  </tr>
</table>
{%- endmacro %}
