# Copy to .env for local overrides. Every value here has a safe default in app/config.py.

# PostgreSQL connection. Standard local server:
DATABASE_URL=postgresql://localhost:5432/yoir
# Postgres.app on macOS commonly uses port 5433 and your macOS user, e.g.:
#   DATABASE_URL=postgresql://evelyn@localhost:5433/yoir

JWT_SECRET=change-me-in-any-real-environment-min-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=60
CORS_ALLOW_ORIGINS=*
SEED_ON_STARTUP=true

# Directory holding the exported Expo web build served at "/", relative to
# backend/. Build it with `npm --prefix ../frontend run build:web` and move
# frontend/dist/web here. Leave it unbuilt to run the API on its own.
FRONTEND_DIST=static
