# Copy to .env for local overrides.
#
# Every variable here has a default in app/config.py, and the defaults are chosen so
# the application runs end to end on a machine with no credentials at all: no Stripe
# account, no mail provider, no PostgreSQL. What that costs you is noted against each
# section.
#
# Names marked [deploy] have a local default that is WRONG for a deployment rather
# than merely different. Deploying without setting them fails quietly — links that go
# nowhere, sessions anyone can mint — rather than refusing to start.
# See docs/deployment/dev-environment.md.


# --- Database ----------------------------------------------------------------
# [deploy] Migrations run automatically on startup, so nothing is applied by hand.
#
# On a managed PostgreSQL with a connection pooler (Neon, Supabase), use the DIRECT
# endpoint here, not the pooled one: startup migrations issue DDL, and a
# transaction-pooled connection is the wrong place for that.
DATABASE_URL=postgresql://localhost:5432/yoir
# Postgres.app on macOS commonly uses port 5433 and your macOS user:
#   DATABASE_URL=postgresql://evelyn@localhost:5433/yoir
# PostgreSQL 16 via the compose file in this directory (`docker compose up -d`):
#   DATABASE_URL=postgresql://yoir:yoir@localhost:5432/yoir
# SQLite, for a machine with no PostgreSQL. The whole test suite runs on it, but it
# does NOT reproduce row locking — SELECT ... FOR UPDATE is a no-op — so the
# double-booking and hold-expiry races are not really exercised:
#   DATABASE_URL=sqlite+pysqlite:///./yoir-local.db


# --- Sessions ----------------------------------------------------------------
# [deploy] JWT_SECRET. The value below is published in this repository; anyone
# holding it can mint a session for any account. Use 32+ random bytes:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-any-real-environment-min-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=60

# How long a session may slide before a password is asked for again. Per platform,
# because the two do not store a credential equally well: on a device it is the
# Keychain or Keystore, in a browser it is localStorage, readable by any script on
# the origin — so a long-lived token there is a far bigger prize.
REFRESH_TOKEN_TTL_DAYS_NATIVE=90
REFRESH_TOKEN_TTL_DAYS_WEB=7

# Single-use link lifetimes. Confirmation is generous because people read mail hours
# later; a reset link is short because it is the more dangerous of the two to leave
# lying in an inbox.
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_HOURS=2


# --- The administrator account -----------------------------------------------
# [deploy] The platform_owner role is never handed out by registration, so without
# these the administration area cannot be reached at all.
#
# The account is created on startup only when it does not already exist, and is
# never modified afterwards: change its password in the app and redeploying will not
# reset it. An address already belonging to an ordinary account is refused rather
# than promoted, so configuration cannot grant somebody administration rights.
#
# This does put a password in configuration. Fine for a development environment;
# for anything holding real accounts, create the owner once and then clear these.
ADMIN_EMAIL=
ADMIN_PASSWORD=


# --- Demo data ---------------------------------------------------------------
# [deploy] Set false. Inserts the counsellors, services and availability in
# app/seed_data.json when the services table is empty. Their password is published
# in this repository, so these are accounts anyone reading it can sign in to.
SEED_ON_STARTUP=true


# --- Serving the web build ---------------------------------------------------
# Directory holding the exported Expo build, served at "/" alongside the API,
# relative to backend/. Build it with `npm --prefix ../frontend run build:web` and
# move frontend/dist/web here. Leave it unbuilt to run the API on its own.
FRONTEND_DIST=static

# [deploy] Origins the API accepts browser calls from. The bundled web build is
# same-origin and needs no entry here; this is for any other client. "*" is for
# local work only.
CORS_ALLOW_ORIGINS=*


# --- Transactional email (Mailgun) -------------------------------------------
# Leave MAILGUN_API_KEY empty and the application logs each message instead of
# sending it, so everything runs end to end with no mail credentials. The startup
# log says which of the two it is doing, because sending never raises: booking
# confirmation runs inside the Stripe webhook, and a non-2xx there would make Stripe
# redeliver the event and re-confirm the booking.
#
# A *sandbox* domain (sandbox....mailgun.org) delivers ONLY to addresses added as
# Authorised Recipients in the Mailgun dashboard. Mail to anyone else is accepted by
# the API and then silently dropped, which looks exactly like a bug in this
# application — so the server warns whenever a sandbox domain is in use.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_BASE_URL=https://api.mailgun.net/v3
MAIL_FROM_NAME=Yoir
# Defaults to postmaster@<MAILGUN_DOMAIN>, which is the address a sandbox owns.
MAIL_FROM_ADDRESS=

# [deploy] Origin the links INSIDE emails point at — the web build, not the API.
# Left at this default, confirmation and password-reset links arrive pointing at
# localhost and cannot work for anyone but you.
APP_WEB_URL=http://localhost:8081


# --- Meeting rooms -----------------------------------------------------------
# Every online booking is given a room named after its own booking id, which is
# unguessable and is doing the access control: anyone who knows a Jitsi room name
# can join it. A counsellor may override this per service with their own Zoom or
# Meet link. The room is fixed when the booking is confirmed and stored, so the
# email, the receipt and the app all name the same one months later.
JITSI_BASE_URL=https://meet.jit.si


# --- Stripe payments ---------------------------------------------------------
# docs/payment/stripe-payment-spec.md
#
# Leave STRIPE_SECRET_KEY empty and the server stays on the development payment
# stub: the booking journey works end to end with no Stripe account. Set it and card
# payments become the only way to pay — the stub endpoint starts refusing requests.
#
# Secret keys live here and nowhere else. The Expo app is served only the publishable
# key, over GET /api/v1/payments/config, so rotating a key or moving between test and
# live needs no new app build.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# [deploy] WITHOUT THESE, PAYMENTS TAKE THE MONEY BUT NO BOOKING IS EVER CONFIRMED.
# Every unverified webhook is rejected with a 400, and a booking exists only once
# payment_intent.succeeded has been accepted. The two endpoints have different
# signing secrets and each refuses the other's.
#
# Locally, from the Stripe CLI:
#   stripe listen \
#     --forward-to localhost:8000/api/v1/payments/stripe/webhook \
#     --forward-connect-to localhost:8000/api/v1/payments/stripe/webhook/connect
#
# In a deployment these come from two webhook endpoints created in the Stripe
# dashboard — the CLI's secrets are for that CLI session and are useless to a server:
#   https://<host>/api/v1/payments/stripe/webhook
#   https://<host>/api/v1/payments/stripe/webhook/connect
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=

# [deploy] Public origin Stripe redirects back to during Connect onboarding. Account
# Links reject non-HTTPS URLs, so testing this locally needs a tunnel (e.g. ngrok).
# Everything other than onboarding works without it.
APP_BASE_URL=http://localhost:8000

# Must match "scheme" in frontend/app.json — it is how the browser half of Connect
# onboarding hands the counsellor back to the app.
APP_DEEP_LINK_SCHEME=yoir

# Origin the Expo web build runs on, for the browser half of Connect onboarding.
# `expo start --web` uses :8081. Leave EMPTY in a deployment, where the backend
# serves the web build itself at APP_BASE_URL.
WEB_APP_BASE_URL=

# Shown in Apple Pay and Google Pay sheets.
MERCHANT_DISPLAY_NAME=Yoir


# --- Commission and policy ---------------------------------------------------
# Still being confirmed with the client's accountant, so every one of these is a
# setting rather than a constant in the pricing code. Changing one affects new
# bookings only: each order carries its own frozen copy of the split, so a rate
# change never rewrites a booking already made, and never restates a receipt.
PLATFORM_FEE_PERCENT=20
PLATFORM_GST_REGISTERED=true
# gst_inclusive: commission is taken from the full price the job seeker pays.
# gst_exclusive: the counsellor's own GST is removed before commission.
COMMISSION_BASE=gst_inclusive
# Yoir's own ABN, printed on the monthly commission statement to counsellors.
PLATFORM_ABN=
PLATFORM_LEGAL_NAME=Yoir

CANCELLATION_FULL_REFUND_HOURS=24
# What a job seeker gets back when they cancel inside the notice window.
# 0 until the client settles the late-cancellation policy.
CANCELLATION_LATE_REFUND_PERCENT=0
# How long an unpaid order holds its time before the slot is released.
SLOT_HOLD_MINUTES=15
# How long after a session takes place the counsellor is paid.
PAYOUT_DELAY_HOURS=24


# --- Background jobs ---------------------------------------------------------
# Hold expiry, session completion and counsellor payouts. They run only where Stripe
# is configured, so a stub deployment starts no scheduler at all.
PAYMENT_JOBS_ENABLED=true
PAYMENT_JOBS_INTERVAL_SECONDS=60
