# Copy to .env for local overrides. Every value here has a safe default in app/config.py.

# PostgreSQL connection. Standard local server:
DATABASE_URL=postgresql+psycopg://localhost:5432/yoir
# Postgres.app on macOS commonly uses port 5433 and your macOS user, e.g.:
#   DATABASE_URL=postgresql+psycopg://evelyn@localhost:5433/yoir

JWT_SECRET=change-me-in-any-real-environment-min-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=60
CORS_ALLOW_ORIGINS=*
SEED_ON_STARTUP=true
